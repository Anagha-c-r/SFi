      "example": "0000001"
    },
    {
      "key": "subsidiary_name",
      "name": "SUBSIDIARY NAME",
      "payload_key": "SUBSIDIARY NAME",
      "type": "string",
      "required": false,
      "description": "Name of subsidiary",
      "example": "XYZ Bank Uganda"
    },
    {
      "key": "reporting_date_month_year",
      "name": "REPORTING DATE, MONTH & YEAR",
      "payload_key": "REPORTING DATE",
      "type": "date",
      "required": true,
      "description": "The reporting date, Month & Year based on the frequency. Format {DD-MMM-YYYY}",
