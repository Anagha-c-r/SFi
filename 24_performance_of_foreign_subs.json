    },
    {
      "key": "gross_deposits_amount",
      "name": "GROSS DEPOSITS AMOUNT",
      "payload_key": "GROSS DEPOSITS AMOUNT",
      "type": "number",
      "required": false,
      "description": "Gross deposit amount (Including accrued interest)",
