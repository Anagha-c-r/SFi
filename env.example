# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Encrypts each institution's CBK client secret. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# First Finoworks platform admin, created when the database has no users
BOOTSTRAP_ADMIN_EMAIL=admin@finoworks.com
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-2026

# Creates "Demo Commercial Bank" with admin/maker/checker users (password Demo-Pass-2026)
SEED_DEMO_DATA=true

# Real CBK endpoints. Leave commented to use the mock CBK server in docker-compose.
# CBK_TOKEN_URL=https://gdi.centralbank.go.ke/oauth2/v1/token
# CBK_UAT_BASE=https://gdi.centralbank.go.ke/preprod
# CBK_PROD_BASE=https://gdi.centralbank.go.ke:443
# Name of the file part for CSV submissions (confirm with CBK's curl samples)
# CBK_FILE_FIELD=file
